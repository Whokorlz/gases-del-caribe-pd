
# -----------------
# CONFIGURACION DE LA BASE DE DATOS (POSTGRESQL)
# -----------------
POSTGRES_USER=gases-del-caribe
POSTGRES_PASSWORD=db-gases-del-caribe-pass
POSTGRES_DB=gases-del-caribe
DB_HOST=postgres_db    # Nombre del servicio de la DB en docker-compose
DB_PORT=5432           # Puerto interno de Postgres

# -----------------
# CONFIGURACION DEL BACKEND (NODE/EXPRESS)
# -----------------
BACKEND_PORT=3001
NODE_ENV=development
JWT_SECRET=jwt-gases-del-caribe-key

# -----------------
# CONFIGURACION DEL FRONTEND (REACT)
# -----------------
FRONTEND_PORT=3000
VITE_API_URL=http://localhost:3001